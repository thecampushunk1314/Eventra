<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_tile_mint"
            android:padding="10dp"
            android:src="@drawable/ic_check"
            app:tint="@color/pastel_mint_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Incharge Account Provisioned"
                android:textColor="@color/charcoal_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dedicated Event &amp; Attendance Console"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_mint"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Active"
            android:textColor="@color/pastel_mint_text"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Credentials Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_lavender"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvCredEventTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆 Inter-Collegiate Football Championship"
            android:textColor="@color/charcoal_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCredInchargeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Appointed Incharge: Aarav Sharma (Student Incharge)"
            android:textColor="@color/pastel_lavender_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/pastel_lavender_chip" />

        <!-- Login Email Row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEDICATED LOGIN EMAIL:"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCredEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="incharge.football@ycasc.com"
                android:textColor="@color/charcoal_dark"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCopyEmail"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_input_box"
                android:padding="6dp"
                android:src="@drawable/ic_copy"
                app:tint="@color/charcoal_dark" />
        </LinearLayout>

        <!-- Login Password Row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="LOGIN PASSWORD:"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCredPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="event123"
                android:textColor="@color/charcoal_dark"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCopyPassword"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_input_box"
                android:padding="6dp"
                android:src="@drawable/ic_copy"
                app:tint="@color/charcoal_dark" />
        </LinearLayout>

        <!-- Meta Details -->
        <TextView
            android:id="@+id/tvCredMultiDayInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="📅 5 Days Practice Camp: 29 Oct 2026 – 02 Nov 2026 (09:00 AM – 11:30 AM)"
            android:textColor="@color/charcoal_dark"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tvCredSquadInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="👥 12 Participating Students Permitted &amp; Enrolled"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ℹ️ Note: The incharge will log into this separate account to track ground attendance for each practice day. When attendance is recorded, students will automatically be credited with Duty Leave and attendance will be redirected to their respective subject teachers."
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyFullCredentials"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="📋 Copy Credentials"
            android:textAllCaps="false"
            android:textColor="@color/charcoal_dark"
            android:textSize="12.5sp"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseCredentials"
            style="@style/Widget.Eventra.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/charcoal_dark"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Done"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>

