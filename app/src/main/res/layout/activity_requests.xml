<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnBackFromRequests"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tile_circle"
            android:contentDescription="Back to Home"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Requests &amp; Passes"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRequestsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Duty leaves, permissions &amp; approvals"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Top Search Bar for Spot Passes & Permissions (Search by words & numbers) -->
    <LinearLayout
        android:id="@+id/layoutSearchRequestsBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_input_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="@color/muted" />

        <EditText
            android:id="@+id/etSearchRequests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search passes by words, numbers, roll no, name..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/charcoal_dark"
            android:textColorHint="@color/text_placeholder"
            android:textSize="13.5sp" />

        <ImageButton
            android:id="@+id/btnClearSearchRequests"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear search"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/muted" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Category Filter Pills (Horizontal Scroll) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Filter 1: All -->
                    <TextView
                        android:id="@+id/chipCategoryAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_selected_charcoal"
                        android:gravity="center"
                        android:text="All Requests"
                        android:textColor="@color/white"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <!-- Filter 2: Spot Passes -->
                    <TextView
                        android:id="@+id/chipCategorySpotPass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_unselected_white"
                        android:gravity="center"
                        android:text="Spot Passes"
                        android:textColor="@color/charcoal_dark"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <!-- Filter 3: Permissions -->
                    <TextView
                        android:id="@+id/chipCategoryPermission"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_unselected_white"
                        android:gravity="center"
                        android:text="Permissions"
                        android:textColor="@color/charcoal_dark"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <!-- Filter 4: Accepted / Approved -->
                    <TextView
                        android:id="@+id/chipCategoryAccepted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_unselected_white"
                        android:drawableStart="@drawable/dot_green"
                        android:drawablePadding="6dp"
                        android:gravity="center"
                        android:text="Accepted"
                        android:textColor="@color/charcoal_dark"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <!-- Filter 5: Pending -->
                    <TextView
                        android:id="@+id/chipCategoryPending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_unselected_white"
                        android:drawableStart="@drawable/dot_amber"
                        android:drawablePadding="6dp"
                        android:gravity="center"
                        android:text="Pending"
                        android:textColor="@color/charcoal_dark"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Metrics Summary Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Metric 1: Total -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_lavender"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvMetricTotalCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/ink"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Total"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Metric 2: Accepted -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_teal"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvMetricAcceptedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/ink"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Accepted"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Metric 3: Pending -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_periwinkle"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvMetricPendingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/ink"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="In Review"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section Label -->
            <TextView
                android:id="@+id/tvRequestsListHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Active Records"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmptyRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_white"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_tile_circle"
                    android:padding="12dp"
                    android:src="@drawable/ic_file"
                    app:tint="@color/muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No Requests in this Category"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Tap '+ New' to submit a Spot Pass or event permission request."
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Dynamic Container for Cards -->
            <LinearLayout
                android:id="@+id/containerRequestsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Dock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_pill"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <!-- Home -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/navReqHome"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_transparent"
                    android:contentDescription="@string/nav_home"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_home"
                    app:tint="@color/white" />
            </FrameLayout>



            <!-- Requests (Active highlighted pill) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/navReqRequests"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_white"
                    android:contentDescription="@string/nav_requests"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_file"
                    app:tint="@color/ink" />
            </FrameLayout>

            <!-- Profile -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/navReqProfile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_transparent"
                    android:contentDescription="@string/nav_profile"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>

        <!-- Floating Action Button (+) -->
        <ImageButton
            android:id="@+id/navReqCreate"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_circle_dark"
            android:contentDescription="@string/nav_create"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_plus"
            app:tint="@color/white" />
    </LinearLayout>

</LinearLayout>
