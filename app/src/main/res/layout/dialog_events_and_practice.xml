<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_tile_mint"
            android:padding="9dp"
            android:src="@drawable/ic_calendar_event"
            app:tint="@color/charcoal_dark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Events &amp; Practice Sessions"
                android:textColor="@color/charcoal_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Co-Curricular Tournament Schedules &amp; Ground Logs"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_mint"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Coordinator"
            android:textColor="@color/pastel_mint_text"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:maxHeight="500dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Active Events -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE INTER-COLLEGIATE &amp; STATE EVENTS"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerEventsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <!-- Section 2: Ground Practice Sessions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SCHEDULED GROUND &amp; VENUE PRACTICE SESSIONS"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerPracticeSessionsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Close button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseEventsDialog"
        style="@style/Widget.Eventra.Button.Pill"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/charcoal_dark"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13.5sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

</LinearLayout>
