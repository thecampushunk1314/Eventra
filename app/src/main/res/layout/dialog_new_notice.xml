<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_tile_lavender"
            android:padding="9dp"
            android:src="@drawable/ic_chat"
            app:tint="@color/charcoal_dark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNoticeDialogHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload &amp; Publish Notice"
                android:textColor="@color/charcoal_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Principal &amp; Faculty Official Notifications"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_mint"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Principal &amp; Faculty"
            android:textColor="@color/pastel_mint_text"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/divider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Notice Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTICE TITLE "
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNoticeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_box"
                android:hint="Enter notice title"
                android:inputType="textCapSentences"
                android:padding="14dp"
                android:textColor="@color/charcoal_dark"
                android:textColorHint="@color/text_muted"
                android:textSize="13.5sp" />

            <!-- Category / Audience -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="CATEGORY"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerNoticeCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_box"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Notice Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="DATE OF ISSUANCE"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNoticeDateDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_box"
                android:padding="14dp"
                android:text="Wed, 21 Oct 2026"
                android:textColor="@color/charcoal_dark"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <!-- Event Time (Optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="EVENT TIME "
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNoticeEventTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_box"
                android:hint="e.g. 10:00 AM – 1:00 PM"
                android:inputType="text"
                android:padding="14dp"
                android:textColor="@color/charcoal_dark"
                android:textColorHint="@color/text_muted"
                android:textSize="13.5sp" />

            <!-- Notice Content / Body -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="OFFICIAL NOTICE CONTENT"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNoticeContent"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_box"
                android:gravity="top|start"
                android:hint="Type official announcement or details here..."
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="@color/charcoal_dark"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <!-- Cc Higher Authority & Meeting Outcomes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_lavender"
                android:orientation="vertical"
                android:padding="12dp">

                <CheckBox
                    android:id="@+id/cbNoticeCcPrincipal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏛️ Carbon Copy (Cc) to Higher Authority (Principal)"
                    android:textColor="@color/charcoal_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="MEETING MINUTES &amp; RECORDED OUTCOMES"
                    android:textColor="@color/pastel_lavender_text"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNoticeMeetingOutcomes"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="top|start"
                    android:hint="Enter meeting outcomes, co-curricular approvals, or formal resolutions..."
                    android:inputType="textMultiLine"
                    android:padding="10dp"
                    android:textColor="@color/charcoal_dark"
                    android:textColorHint="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelNotice"
            style="@style/Widget.Eventra.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:backgroundTint="#F1F5F9"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/charcoal_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublishNotice"
            style="@style/Widget.Eventra.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.6"
            android:backgroundTint="@color/charcoal_dark"
            android:text="Submit &amp; Publish Notice"
            android:contentDescription="Submit to Publish Notice"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="16dp"
            app:iconTint="@color/white" />
    </LinearLayout>

</LinearLayout>
