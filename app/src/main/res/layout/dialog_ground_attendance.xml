<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_tile_mint"
            android:padding="9dp"
            android:src="@drawable/ic_check"
            app:tint="@color/charcoal_dark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ground Practice Attendance"
                android:textColor="@color/charcoal_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGroundSessionMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Football Practice • Main Ground (07:00 AM)"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGroundPresentCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_mint"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="0 Present"
            android:textColor="@color/pastel_mint_text"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_lavender"
        android:padding="10dp"
        android:text="⚡ Physical presence verified on the ground will automatically apply authorized duty leave credit to the students' official academic attendance records."
        android:textColor="@color/charcoal_dark"
        android:textSize="11.5sp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="380dp">

        <LinearLayout
            android:id="@+id/containerGroundRosterList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelGroundAtt"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/charcoal_dark"
            android:textSize="13.5sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveGroundAtt"
            style="@style/Widget.Eventra.Button.Pill"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.3"
            android:backgroundTint="@color/charcoal_dark"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="⚽ Save &amp; Credit"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13.5sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
