<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with previous pastel aesthetic -->
    <style name="Base.Theme.Eventra2" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/charcoal_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/pastel_lavender_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/bg_canvas</item>
        <item name="android:statusBarColor">@color/bg_canvas</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="Theme.Eventra2" parent="Base.Theme.Eventra2" />

    <!-- Button Styles -->
    <style name="Widget.Eventra.Button.Pill" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="backgroundTint">@color/charcoal_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Eventra.Button.Purple" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="backgroundTint">@color/pastel_lavender_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Eventra.Button.Charcoal" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="backgroundTint">@color/charcoal_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>